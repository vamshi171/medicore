{
  "info": {
    "name": "MediCore API",
    "description": "Complete API collection for the MediCore healthcare microservices system. Import postman/medicore.seed.postman_environment.json and select it, then run Auth → Login first (accessToken is auto-saved).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "demoEmail", "value": "" },
    { "key": "demoPassword", "value": "" },
    { "key": "registerEmail", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('accessToken', json.data.token);",
                  "  pm.test('token saved', () => pm.expect(json.data.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}" }
          }
        },
        {
          "name": "Register patient",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"role\": \"PATIENT\"\n}" }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "List users (ADMIN)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/users?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "auth", "users"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] }
          }
        },
        {
          "name": "Deactivate user (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/users/2/status", "host": ["{{baseUrl}}"], "path": ["api", "auth", "users", "2", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"active\": false\n}" }
          }
        },
        {
          "name": "Deactivate self",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Create my profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/patients/me", "host": ["{{baseUrl}}"], "path": ["api", "patients", "me"] },
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Test Patient\",\n  \"dateOfBirth\": \"1995-06-15\",\n  \"gender\": \"FEMALE\",\n  \"phone\": \"9876543210\",\n  \"bloodGroup\": \"O+\",\n  \"allergies\": \"Penicillin\",\n  \"chronicConditions\": \"None\"\n}" }
          }
        },
        { "name": "Get my profile", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/patients/me", "host": ["{{baseUrl}}"], "path": ["api", "patients", "me"] } } },
        { "name": "List patients (ADMIN)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/patients?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "patients"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }] } } }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Create my profile (DOCTOR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/doctors/me", "host": ["{{baseUrl}}"], "path": ["api", "doctors", "me"] },
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Dr. Aisha Verma\",\n  \"specialization\": \"Dermatology\",\n  \"bio\": \"Skin specialist\",\n  \"consultationFee\": 500,\n  \"experienceYears\": 8,\n  \"phone\": \"9876500000\",\n  \"availableFrom\": \"09:00:00\",\n  \"availableTo\": \"17:00:00\"\n}" }
          }
        },
        {
          "name": "Search doctors (public)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/api/doctors?specialization=Dermatology&minExperience=3&page=0", "host": ["{{baseUrl}}"], "path": ["api", "doctors"], "query": [{ "key": "specialization", "value": "Dermatology" }, { "key": "minExperience", "value": "3" }, { "key": "page", "value": "0" }] }
          }
        },
        { "name": "Specializations (public)", "request": { "method": "GET", "auth": { "type": "noauth" }, "url": { "raw": "{{baseUrl}}/api/doctors/specializations", "host": ["{{baseUrl}}"], "path": ["api", "doctors", "specializations"] } } },
        { "name": "Toggle availability (DOCTOR)", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/api/doctors/me/availability?available=false", "host": ["{{baseUrl}}"], "path": ["api", "doctors", "me", "availability"], "query": [{ "key": "available", "value": "false" }] } } }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book appointment (PATIENT)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] },
            "body": { "mode": "raw", "raw": "{\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2026-12-01T10:00:00\",\n  \"reason\": \"Skin rash\"\n}" }
          }
        },
        { "name": "My appointments (patient)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/me/patient", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "me", "patient"] } } },
        { "name": "My appointments (doctor)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/me/doctor", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "me", "doctor"] } } },
        { "name": "Cancel appointment", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/api/appointments/1/cancel", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "1", "cancel"] } } },
        { "name": "Confirm appointment (DOCTOR)", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/api/appointments/1/status?status=CONFIRMED", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "1", "status"], "query": [{ "key": "status", "value": "CONFIRMED" }] } } },
        { "name": "Stats (ADMIN)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/appointments/stats", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "stats"] } } }
      ]
    },
    {
      "name": "Blood Bank",
      "item": [
        { "name": "Metadata", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/metadata", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "metadata"] } } },
        { "name": "Availability search", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/availability?bloodGroup=O_NEGATIVE&component=RED_CELLS&city=Hyderabad", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "availability"], "query": [{ "key": "bloodGroup", "value": "O_NEGATIVE" }, { "key": "component", "value": "RED_CELLS" }, { "key": "city", "value": "Hyderabad" }] } } },
        { "name": "Compatibility lookup", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/compatibility/O_NEGATIVE", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "compatibility", "O_NEGATIVE"] } } },
        {
          "name": "Register as donor (self)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/bloodbank/donors/me", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "donors", "me"] },
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Priya Nair\",\n  \"bloodGroup\": \"O_POSITIVE\",\n  \"age\": 31,\n  \"weightKg\": 58,\n  \"phone\": \"9000000000\",\n  \"city\": \"Hyderabad\",\n  \"lastDonationDate\": null\n}" }
          }
        },
        { "name": "My donor profile", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/donors/me", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "donors", "me"] } } },
        {
          "name": "Raise a transfusion request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/bloodbank/requests", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "requests"] },
            "body": { "mode": "raw", "raw": "{\n  \"patientName\": \"Priya Nair\",\n  \"bloodGroup\": \"A_POSITIVE\",\n  \"component\": \"RED_CELLS\",\n  \"unitsNeeded\": 2,\n  \"urgency\": \"ELECTIVE\",\n  \"hospital\": \"MediCore Transplant Centre\",\n  \"city\": \"Hyderabad\",\n  \"reason\": \"Post-op transfusion\"\n}" }
          }
        },
        { "name": "My requests", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/requests/mine", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "requests", "mine"] } } },
        { "name": "Request board (OFFICER/ADMIN)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/requests?status=REQUESTED&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "requests"], "query": [{ "key": "status", "value": "REQUESTED" }, { "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } } },
        { "name": "Inventory (OFFICER/ADMIN)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/inventory?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "inventory"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } } },
        { "name": "Expiring lots (OFFICER/ADMIN)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/inventory/expiring?days=7", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "inventory", "expiring"], "query": [{ "key": "days", "value": "7" }] } } },
        { "name": "Donor registry (OFFICER/ADMIN)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/donors?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "donors"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } } },
        {
          "name": "Decide request (OFFICER/ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/bloodbank/requests/1/decision", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "requests", "1", "decision"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"APPROVED\",\n  \"note\": \"Group confirmed\"\n}" }
          }
        },
        { "name": "Cancel my request (owner)", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/api/bloodbank/requests/1/cancel", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "requests", "1", "cancel"] } } },
        { "name": "Stats", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/bloodbank/stats", "host": ["{{baseUrl}}"], "path": ["api", "bloodbank", "stats"] } } }
      ]
    },
    {
      "name": "Organ Donation",
      "item": [
        { "name": "Metadata", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/organs/metadata", "host": ["{{baseUrl}}"], "path": ["api", "organs", "metadata"] } } },
        { "name": "Stats", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/organs/stats", "host": ["{{baseUrl}}"], "path": ["api", "organs", "stats"] } } },
        {
          "name": "Pledge to donate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/organs/pledges/me", "host": ["{{baseUrl}}"], "path": ["api", "organs", "pledges", "me"] },
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Priya Nair\",\n  \"bloodGroup\": \"O_POSITIVE\",\n  \"age\": 31,\n  \"city\": \"Hyderabad\",\n  \"phone\": \"9000000000\",\n  \"organs\": [\"KIDNEY\", \"LIVER\", \"CORNEA\"],\n  \"consentSigned\": true,\n  \"medicalNotes\": null\n}" }
          }
        },
        { "name": "My pledge", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/organs/pledges/me", "host": ["{{baseUrl}}"], "path": ["api", "organs", "pledges", "me"] } } },
        { "name": "Revoke my pledge", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/api/organs/pledges/me/revoke", "host": ["{{baseUrl}}"], "path": ["api", "organs", "pledges", "me", "revoke"] } } },
        { "name": "Pledge registry (COORDINATOR/ADMIN)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/organs/pledges?status=PENDING&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "organs", "pledges"], "query": [{ "key": "status", "value": "PENDING" }, { "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } } },
        {
          "name": "Verify a pledge (COORDINATOR)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/organs/pledges/1/verify", "host": ["{{baseUrl}}"], "path": ["api", "organs", "pledges", "1", "verify"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"VERIFIED\",\n  \"note\": \"Consent form on file\"\n}" }
          }
        },
        {
          "name": "Add patient to waitlist (DOCTOR/COORDINATOR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/organs/waitlist", "host": ["{{baseUrl}}"], "path": ["api", "organs", "waitlist"] },
            "body": { "mode": "raw", "raw": "{\n  \"patientUserId\": 4,\n  \"organNeeded\": \"KIDNEY\",\n  \"bloodGroup\": \"A_POSITIVE\",\n  \"urgencyScore\": 8,\n  \"hospital\": \"MediCore Transplant Centre\",\n  \"city\": \"Hyderabad\",\n  \"notes\": \"Dialysis-dependent\"\n}" }
          }
        },
        { "name": "My waitlist entries", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/organs/waitlist/mine", "host": ["{{baseUrl}}"], "path": ["api", "organs", "waitlist", "mine"] } } },
        { "name": "Waiting list (staff)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/organs/waitlist?status=WAITING&page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "organs", "waitlist"], "query": [{ "key": "status", "value": "WAITING" }, { "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } } },
        { "name": "Ranked candidates (COORDINATOR)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/organs/waitlist/1/candidates", "host": ["{{baseUrl}}"], "path": ["api", "organs", "waitlist", "1", "candidates"] } } },
        {
          "name": "Propose an allocation (COORDINATOR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/organs/matches", "host": ["{{baseUrl}}"], "path": ["api", "organs", "matches"] },
            "body": { "mode": "raw", "raw": "{\n  \"donorId\": 1,\n  \"recipientId\": 1,\n  \"notes\": \"Best available ABO match\"\n}" }
          }
        },
        { "name": "Allocation book (COORDINATOR)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/organs/matches?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "organs", "matches"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } } },
        { "name": "My allocations", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/organs/matches/mine", "host": ["{{baseUrl}}"], "path": ["api", "organs", "matches", "mine"] } } },
        {
          "name": "Update allocation status (COORDINATOR)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/organs/matches/1/status", "host": ["{{baseUrl}}"], "path": ["api", "organs", "matches", "1", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"notes\": \"Theatre booked\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        { "name": "My notifications", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/notifications?page=0&size=20", "host": ["{{baseUrl}}"], "path": ["api", "notifications"], "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "20" }] } } }
      ]
    }
  ]
}
